# =============================================================================
# Eygar Auth Profile — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.

# --- Django Settings ---
ENV=local
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
DB_NAME=dev_eygar_auth_profile
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432


# --- Frontend Configuration ---
SITE_URL=http://localhost:3000

# --- AWS S3 ---
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION_NAME=ap-south-1
AWS_S3_BUCKET_NAME=your-s3-bucket
AWS_S3_FILE_OVERWRITE=True

# --- AWS SQS (Direct Notification & Domain Events Queue) ---
AWS_SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/637423303507/eygar-queues
AWS_SQS_EMAIL_QUEUE_URL=


# --- Social Auth ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# --- Verification Settings ---
# These have defaults in settings.py, override here if needed:
# VERIFICATION_CODE_LENGTH=6
# VERIFICATION_CODE_EXPIRY_MINUTES=10
